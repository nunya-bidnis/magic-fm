# Magic.fm Environment Configuration
# Copy to .env and fill in your values

# Application
DOMAIN=magic.fm
APP_NAME=Magic.fm
DEBUG=False
WORKERS=4

# Account creation
#
# Keep this FALSE. Magic.fm accounts are created by an admin after an interview,
# via /admin.html. Setting this true re-opens public self-registration, which lets
# anyone who finds the login page mint themselves a working stream key.
ALLOW_OPEN_REGISTRATION=false

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Database
DATABASE_PATH=./magic.db

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# RTMP Server (for stream validation)
RTMP_SERVER_IP=127.0.0.1
RTMP_AUTH_PORT=8080

# DASH Streaming
DASH_MANIFEST_URL=/api/stream/dash/manifest.mpd
DASH_SEGMENT_DURATION=4
DASH_WINDOW_SIZE=30

# Discord Integration
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_SECRET=your-discord-webhook-secret

# CORS
CORS_ORIGINS=["https://magic.fm", "https://www.magic.fm"]

# Session
SESSION_TIMEOUT_MINUTES=1440

# Logging
LOG_LEVEL=INFO
