# Magic.fm Systemd Service File
# Place this file at: /etc/systemd/system/magic-fm.service
#
# Enable & start:
#   sudo systemctl daemon-reload
#   sudo systemctl enable magic-fm
#   sudo systemctl start magic-fm
#
# View logs:
#   sudo systemctl status magic-fm
#   sudo journalctl -u magic-fm -f

[Unit]
Description=Magic.fm - 24/7 Online Radio Station
After=network.target
Documentation=https://github.com/yourusername/magic-fm

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/magic-fm

# Python virtual environment
Environment="PATH=/var/www/magic-fm/venv/bin"
Environment="PYTHONUNBUFFERED=1"

# Environment configuration
EnvironmentFile=/var/www/magic-fm/.env

# Main process
ExecStart=/var/www/magic-fm/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 4

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=60s
StartLimitBurst=3

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www/magic-fm

# Process limits
LimitNOFILE=65535
LimitNPROC=65535

# Timeout for graceful shutdown
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
