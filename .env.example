JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
DATABASE_PATH=./magic.db
ALLOW_OPEN_REGISTRATION=false
JWT_EXPIRE_HOURS=24

# Discord chat bridge - leave blank to disable. Webhook posts site messages
# into Discord; bot token + channel ID let the separate discord_bot.py
# process relay real Discord messages back onto the site.
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
