[Unit]
Description=Magic.fm Discord chat relay
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/magic-fm
EnvironmentFile=/var/www/magic-fm/.env
ExecStart=/var/www/magic-fm/venv/bin/python discord_bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
