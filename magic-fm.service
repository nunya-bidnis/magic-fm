[Unit]
Description=Magic.fm FastAPI backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/magic-fm
EnvironmentFile=/var/www/magic-fm/.env
ExecStart=/var/www/magic-fm/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
